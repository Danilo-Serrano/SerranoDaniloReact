# Secretos para el emulador local. Copiar como functions/.secret.local (ignorado por git).
# En producción se cargan con: firebase functions:secrets:set MP_ACCESS_TOKEN

# Access Token de PRUEBA del VENDEDOR de prueba (empieza con TEST- o APP_USR-)
MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxx

# Clave secreta de Webhooks (Tus integraciones > Webhooks > Clave secreta). Vacío = no valida firma.
MP_WEBHOOK_SECRET=87083d08c3429c6e5dd804b9bc44d3b27095cd6ccf6bf12654daebc8f0b914fd
