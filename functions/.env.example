# Variables NO secretas de las Cloud Functions.
# functions/.env        -> producción (firebase deploy)
# functions/.env.local  -> emulador local (pisa a .env)

# URL pública del frontend, sin "/" final (para las back_urls de Mercado Pago)
APP_URL=https://tu-sitio.vercel.app

# URL pública de la función mpWebhook
# Producción: https://us-central1-gamerzone2.cloudfunctions.net/mpWebhook
# Local:      https://TU-SUBDOMINIO.ngrok-free.app/gamerzone2/us-central1/mpWebhook
WEBHOOK_URL=https://us-central1-gamerzone2.cloudfunctions.net/mpWebhook

# external_id de la caja (POS) creada en Mercado Pago para el QR dinámico
QR_POS_ID=GAMERZONE001POS001
