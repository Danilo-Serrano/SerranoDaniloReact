# Variables del FRONTEND (Vite). Todo lo que empieza con VITE_ queda PÚBLICO en el bundle.
# Acá va SOLO la Public Key. El Access Token NUNCA va acá (ver functions/.env.example).

# Public Key de Mercado Pago (Tus integraciones > tu aplicación > Credenciales de prueba)
VITE_MP_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# URL base de las Cloud Functions (sin "/" final)
# Local (emulador):  http://127.0.0.1:5001/gamerzone2/us-central1
# Producción:        https://us-central1-gamerzone2.cloudfunctions.net
VITE_FUNCTIONS_BASE_URL=http://127.0.0.1:5001/gamerzone2/us-central1

# Opcional: usar los emuladores locales de Firestore y Auth en vez de producción.
# Sirve para probar el panel /admin sin tocar datos reales:
#   firebase emulators:start --only auth,firestore
# VITE_USE_EMULATORS=true
